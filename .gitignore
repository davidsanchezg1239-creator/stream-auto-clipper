# Python / Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environment variables & secrets (CRITICAL)
.env
.env.local
.env.*.local
*.key

# Application Data & Credentials
credentials/*.json
credentials/browser_profiles/
credentials/*.flag
!credentials/.gitkeep

# Local SQLite Database
data/*.db
data/*.sqlite
data/*.sqlite3
!data/.gitkeep

# Video Storage (Gigabytes of video downloads & processed clips)
storage/downloads/*
storage/processed/*
storage/compilations/*
storage/*.png
storage/*.jpg
storage/*.mp4
storage/*.ass
!storage/downloads/.gitkeep
!storage/processed/.gitkeep
!storage/compilations/.gitkeep

# Playwright & Browsers
.playwright/
playwright-report/
test-results/

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDEs & Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
