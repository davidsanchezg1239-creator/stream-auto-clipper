# ==========================================
# STREAM AUTO CLIPPER - CONFIGURATION
# ==========================================

# General Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
DATABASE_URL=sqlite:///./data/clipper.db

# Path to FFmpeg executable (if not in system PATH)
# On Windows, e.g.: C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Storage directories (relative or absolute)
DOWNLOADS_DIR=./storage/downloads
PROCESSED_DIR=./storage/processed
COMPILATIONS_DIR=./storage/compilations

# ==========================================
# AI / LLM & TRANSCRIPTION
# ==========================================
# Google Gemini API key (Used to analyze transcripts, detect highlights, create viral titles & hashtags)
GEMINI_API_KEY=your_gemini_api_key_here

# Whisper settings
# Options: "tiny", "base", "small", "medium", "large-v3" or "groq_api"
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu

# ==========================================
# TWITCH API (Optional for EventSub & Clips)
# Get from: https://dev.twitch.tv/console/apps
# ==========================================
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_WEBHOOK_SECRET=your_webhook_secret_string

# ==========================================
# YOUTUBE DATA API (OAuth Client Credentials)
# Get from: Google Cloud Console (YouTube Data API v3)
# ==========================================
YOUTUBE_CLIENT_SECRETS_FILE=./credentials/client_secret.json
YOUTUBE_TOKEN_FILE=./credentials/youtube_token.json

# ==========================================
# SOCIAL MEDIA PUBLISHING (TikTok / Instagram)
# Option 1: Ayrshare API (Easiest unified publishing to TikTok, IG, YT, X)
AYRSHARE_API_KEY=your_ayrshare_api_key

# Option 2: Meta / Instagram Graph API
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_api_token

# Option 3: TikTok API
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
